# Application
APP_ENV=development
APP_NAME=land-fraud-detection
APP_DEBUG=true
APP_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg2://landuser:landpass@localhost:5432/land_verification
DB_HOST=localhost
DB_PORT=5432
DB_NAME=land_verification
DB_USER=landuser
DB_PASSWORD=landpass

# Security
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:3000

# AI / ML
MODEL_PATH=ml/models/risk_model.joblib
SYNTHETIC_DATA_PATH=ml/data/synthetic_land_transactions.csv

# Admin defaults
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
